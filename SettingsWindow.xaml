                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="PreviewArt" Width="56" Height="56" CornerRadius="8" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1" Margin="10,2,0,0">
                                            <TextBlock x:Name="PreviewTitle" Text="Música tocando" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="PreviewArtist" Text="Artista" FontSize="11.5" Opacity="0.7"/>
                                        </StackPanel>
                                        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="PreviewPrev" Text="&#xE892;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"/>
                                            <Border x:Name="PreviewPlay" Width="28" Height="28" CornerRadius="14" Margin="14,0">
                                                <TextBlock x:Name="PreviewPlayGlyph" Text="&#xE769;" FontFamily="{StaticResource Icons}" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="PreviewNext" Text="&#xE893;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Temas prontos e personalizados -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Galeria de temas"/>
                            <WrapPanel x:Name="PalettePanel"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Clique com o botão direito num widget → Tema deste widget para usar um tema diferente só nele."/>
                        </StackPanel>
                    </Border>

                    <!-- Cores -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Cores personalizadas"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Topo do gradiente" VerticalAlignment="Center"/>
                                <Button Grid.Row="0" Grid.Column="1" x:Name="TopSwatch" Tag="Top" Style="{StaticResource SwatchButton}" Click="Swatch_Click"/>
                                <TextBox Grid.Row="0" Grid.Column="2" x:Name="TopHex" Tag="Top" Height="32" TextChanged="Hex_TextChanged"/>

                                <TextBlock Grid.Row="1" Text="Base do gradiente" VerticalAlignment="Center"/>
                                <Button Grid.Row="1" Grid.Column="1" x:Name="BottomSwatch" Tag="Bottom" Style="{StaticResource SwatchButton}" Click="Swatch_Click"/>
                                <TextBox Grid.Row="1" Grid.Column="2" x:Name="BottomHex" Tag="Bottom" Height="32" TextChanged="Hex_TextChanged"/>

                                <TextBlock Grid.Row="2" Text="Destaque (hoje, botões, progresso)" VerticalAlignment="Center"/>
                                <Button Grid.Row="2" Grid.Column="1" x:Name="AccentSwatch" Tag="Accent" Style="{StaticResource SwatchButton}" Click="Swatch_Click"/>
                                <TextBox Grid.Row="2" Grid.Column="2" x:Name="AccentHex" Tag="Accent" Height="32" TextChanged="Hex_TextChanged"/>

                                <TextBlock Grid.Row="3" Text="Texto" VerticalAlignment="Center"/>
                                <Button Grid.Row="3" Grid.Column="1" x:Name="TextSwatch" Tag="Text" Style="{StaticResource SwatchButton}" Click="Swatch_Click"/>
                                <TextBox Grid.Row="3" Grid.Column="2" x:Name="TextHex" Tag="Text" Height="32" TextChanged="Hex_TextChanged"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Salvar como tema" Margin="10,0,0,0" Click="SaveTheme_Click"/>
                                <TextBox x:Name="ThemeNameBox" Height="34" ToolTip="Nome do novo tema"/>
                            </DockPanel>
                            <TextBlock x:Name="ThemeSaveStatus" Style="{StaticResource Hint}" Text="Dê um nome e salve: o tema aparece na galeria e no menu de cada widget."/>
                        </StackPanel>
                    </Border>

                    <!-- Estilo -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Estilo dos blocos"/>

                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Background="{StaticResource Field}" CornerRadius="9" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="DirVertical" Style="{StaticResource Segment}" GroupName="dir" Content="Vertical" Tag="Vertical" Click="Direction_Click"/>
                                        <RadioButton x:Name="DirHorizontal" Style="{StaticResource Segment}" GroupName="dir" Content="Horizontal" Tag="Horizontal" Click="Direction_Click"/>
                                        <RadioButton x:Name="DirDiagonal" Style="{StaticResource Segment}" GroupName="dir" Content="Diagonal" Tag="Diagonal" Click="Direction_Click"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Direção do gradiente" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>

                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                <Slider x:Name="OpacitySlider" DockPanel.Dock="Right" Width="240" Minimum="0" Maximum="100" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Opacity_Changed"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Opacidade do fundo"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Em 0% só texto e ícones flutuam sobre o papel de parede."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>

                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock x:Name="RadiusValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                <Slider x:Name="RadiusSlider" DockPanel.Dock="Right" Width="240" Minimum="0" Maximum="32" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Radius_Changed"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Arredondamento dos cantos" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>

                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock x:Name="BorderValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                <Slider x:Name="BorderSlider" DockPanel.Dock="Right" Width="240" Minimum="0" Maximum="50" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Border_Changed"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Contorno dos blocos" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>

                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="UiFontBox" DockPanel.Dock="Right" Width="240" SelectionChanged="UiFont_Changed" IsTextSearchEnabled="True"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Fonte dos widgets"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Usada em títulos, notas, música e componentes."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>

                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="AnimatedCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Animated_Click"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,18,0" VerticalAlignment="Center">
                                    <c:AnimatedIcon x:Name="Demo1" Kind="Spinner" Width="18" Height="18" Brush="{StaticResource Fg}" Margin="0,0,10,0"/>
                                    <c:AnimatedIcon x:Name="Demo2" Kind="Dots" Width="18" Height="18" Brush="{StaticResource Fg}" Margin="0,0,10,0"/>
                                    <c:AnimatedIcon x:Name="Demo3" Kind="Equalizer" Width="18" Height="18" Brush="{StaticResource Fg}" Margin="0,0,10,0"/>
                                    <c:AnimatedIcon x:Name="Demo4" Kind="Hourglass" Width="18" Height="18" Brush="{StaticResource Fg}" Margin="0,0,10,0"/>
                                    <c:AnimatedIcon x:Name="Demo5" Kind="Wifi" Width="18" Height="18" Brush="{StaticResource Fg}" Margin="0,0,10,0"/>
                                    <c:AnimatedIcon x:Name="Demo6" Kind="Pulse" Width="18" Height="18" Brush="{StaticResource Fg}" Margin="0,0,10,0"/>
                                    <c:AnimatedIcon x:Name="Demo7" Kind="Ball" Width="18" Height="18" Brush="{StaticResource Fg}" Margin="0,0,10,0"/>
                                    <c:AnimatedIcon x:Name="Demo8" Kind="Clock" Width="18" Height="18" Brush="{StaticResource Fg}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Ícones animados"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Só se mexem quando algo acontece (música tocando, pomodoro, carregando)."/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== WIDGETS ========== -->
                <StackPanel x:Name="PageWidgets" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Widgets e layout"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Cada widget é independente: arraste para mover, puxe o canto inferior direito para redimensionar (Shift mantém a proporção, Alt desliga o encaixe) ou use Ctrl + roda do mouse."/>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Seus widgets"/>
                            <StackPanel x:Name="WidgetList"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Organização"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="EditModeCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="EditMode_Click"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Modo de edição"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Mostra contornos, nomes e alças; os widgets ficam por cima das janelas até você desligar (ou Esc)."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="SnapWidgetsCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Snap_Click"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Encaixe magnético"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Gruda nas bordas dos outros widgets e da tela, mantendo o espaçamento."/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock x:Name="GapValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                <Slider x:Name="GapSlider" DockPanel.Dock="Right" Width="240" Minimum="0" Maximum="40" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Gap_Changed"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Espaço entre widgets" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="SnapGridCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Snap_Click"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Alinhar à grade" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock x:Name="GridValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                <Slider x:Name="GridSlider" DockPanel.Dock="Right" Width="240" Minimum="2" Maximum="40" TickFrequency="2"
                                        IsSnapToTickEnabled="True" ValueChanged="Grid_Changed"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Tamanho da grade" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Style="{StaticResource Primary}" Content="Alinhar todos automaticamente" Margin="0,0,8,8" Click="AutoArrange_Click"/>
                                <Button Content="Mostrar todos" Margin="0,0,8,8" Click="ShowAll_Click"/>
                                <Button Content="Restaurar layout padrão" Margin="0,0,8,8" Click="ResetLayout_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Camada e travamento"/>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="ZModeBox" DockPanel.Dock="Right" Width="300" SelectionChanged="ZMode_Changed">
                                    <ComboBoxItem Content="Fixo na área de trabalho" Tag="Desktop"/>
                                    <ComboBoxItem Content="Janela comum" Tag="Normal"/>
                                    <ComboBoxItem Content="Sempre visível (por cima de tudo)" Tag="Topmost"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Onde os widgets ficam" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="LockCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Lock_Click"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Travar posição e tamanho"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Evita mover sem querer. Botões, notas e controles continuam funcionando."/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== RELÓGIO ========== -->
                <StackPanel x:Name="PageClock" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Relógio e calendário"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="O relógio acorda só uma vez por minuto (ou por segundo, se mostrar os segundos)."/>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Fonte da hora"/>
                            <ComboBox x:Name="FontBox" SelectionChanged="Font_Changed" IsTextSearchEnabled="True"/>
                            <Border Background="{StaticResource Field}" CornerRadius="10" Margin="0,10,0,0" Padding="10,6">
                                <TextBlock x:Name="FontPreview" Text="10:22" FontSize="54" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Formato"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="BoldCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="ClockOptions_Click"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Negrito" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="H24Check" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="ClockOptions_Click"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Formato 24 horas" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="SecondsCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="ClockOptions_Click"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Mostrar segundos"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Com segundos o relógio atualiza 1 vez por segundo."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="ShowDateCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="ClockOptions_Click"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Mostrar a data embaixo da hora" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="CultureBox" DockPanel.Dock="Right" Width="240" SelectionChanged="Culture_Changed">
                                    <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/>
                                    <ComboBoxItem Content="English (US)" Tag="en-US"/>
                                    <ComboBoxItem Content="Español" Tag="es-ES"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Idioma da data e do calendário" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== CLIMA ========== -->
                <StackPanel x:Name="PageWeather" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Clima"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Dados do Open-Meteo, atualizados a cada 30 minutos. Clique no widget para atualizar na hora."/>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Cidade"/>
                            <TextBlock x:Name="CurrentCity" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="Search_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:AnimatedIcon x:Name="SearchSpin" Kind="Spinner" Width="13" Height="13" Brush="White" Margin="0,0,7,0" Visibility="Collapsed"/>
                                        <TextBlock Text="Buscar"/>
                                    </StackPanel>
                                </Button>
                                <TextBox x:Name="CityBox" Height="34" KeyDown="CityBox_KeyDown"/>
                            </DockPanel>
                            <TextBlock x:Name="SearchStatus" Style="{StaticResource Hint}"/>
                            <ListBox x:Name="CityResults" Visibility="Collapsed" MaxHeight="200" Margin="0,8,0,0"
                                     SelectionChanged="CityResults_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" Padding="4,5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Exibição"/>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="UnitBox" DockPanel.Dock="Right" Width="200" SelectionChanged="Unit_Changed">
                                    <ComboBoxItem Content="Celsius (°C)" Tag="celsius"/>
                                    <ComboBoxItem Content="Fahrenheit (°F)" Tag="fahrenheit"/>
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Unidade"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Vale também para as temperaturas dos componentes."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="WeatherBgCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="WeatherBg_Click"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Sem fundo (ícone flutuando)" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== MÚSICA ========== -->
                <StackPanel x:Name="PageMusic" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Música"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Mostra o que está tocando no Windows: Spotify, YouTube e outros sites no navegador, Apple Music, Deezer, players de vídeo… Os botões controlam o player direto."/>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Aparência"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="MusicArtCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Music_Click"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Mostrar a capa do álbum" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="MusicBackdropCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Music_Click"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Capa desfocada no fundo"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="O widget ganha as cores da música que está tocando."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="MusicProgressCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Music_Click"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Barra de progresso e tempo"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Atualiza uma vez por segundo, só enquanto toca."/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== POMODORO ========== -->
                <StackPanel x:Name="PagePomodoro" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Pomodoro"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Ciclos de foco e pausa. Clique em Foco / Pausa / Longa no widget para trocar de etapa."/>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Durações"/>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock x:Name="FocusValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                <Slider x:Name="FocusSlider" DockPanel.Dock="Right" Width="280" Minimum="5" Maximum="90" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Pomodoro_Changed"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Foco" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock x:Name="ShortValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                <Slider x:Name="ShortSlider" DockPanel.Dock="Right" Width="280" Minimum="1" Maximum="30" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Pomodoro_Changed"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Pausa curta" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock x:Name="LongValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                <Slider x:Name="LongSlider" DockPanel.Dock="Right" Width="280" Minimum="5" Maximum="60" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Pomodoro_Changed"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Pausa longa" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock x:Name="CyclesValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                <Slider x:Name="CyclesSlider" DockPanel.Dock="Right" Width="280" Minimum="2" Maximum="8" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Pomodoro_Changed"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Focos até a pausa longa" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Ao terminar uma etapa"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="PomoAutoCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="PomodoroOptions_Click"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Começar a próxima automaticamente" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="PomoSoundCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="PomodoroOptions_Click"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Tocar um som" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="PomoNotifyCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="PomodoroOptions_Click"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Mostrar notificação do Windows" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== COMPONENTES ========== -->
                <StackPanel x:Name="PageHardware" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Componentes"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Temperatura da CPU, GPU e SSD, uso da CPU e memória."/>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Leituras agora"/>
                            <TextBlock x:Name="HwStatus" TextWrapping="Wrap" Text="Lendo…"/>
                            <TextBlock x:Name="HwSources" Style="{StaticResource Hint}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0">
                                O Windows não deixa programas comuns lerem a CPU com precisão. Para valores exatos de CPU, GPU AMD/Intel e SSD,
                                deixe o <Hyperlink NavigateUri="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor/releases"
                                RequestNavigate="Link_RequestNavigate" Foreground="#A99FFF">LibreHardwareMonitor</Hyperlink> aberto (minimizado na bandeja):
                                o DeskWidgets detecta sozinho. GPUs NVIDIA são lidas direto do driver.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="O que mostrar"/>
                            <UniformGrid Columns="2">
                                <DockPanel Style="{StaticResource Row}" Margin="0,6,24,6">
                                    <CheckBox x:Name="HwCpuTempCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="HwOptions_Click"/>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Temperatura da CPU" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="HwGpuTempCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="HwOptions_Click"/>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Temperatura da GPU" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}" Margin="0,6,24,6">
                                    <CheckBox x:Name="HwDiskCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="HwOptions_Click"/>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Temperatura do SSD" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="HwLoadCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="HwOptions_Click"/>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Uso da CPU" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}" Margin="0,6,24,6">
                                    <CheckBox x:Name="HwRamCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="HwOptions_Click"/>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Memória RAM" VerticalAlignment="Center"/>
                                </DockPanel>
                            </UniformGrid>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock x:Name="HwRefreshValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                <Slider x:Name="HwRefreshSlider" DockPanel.Dock="Right" Width="260" Minimum="2" Maximum="60" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Hw_Changed"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Atualizar a cada" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock x:Name="HwWarnValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                <Slider x:Name="HwWarnSlider" DockPanel.Dock="Right" Width="260" Minimum="50" Maximum="100" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Hw_Changed"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Alerta de temperatura"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Acima disso a barra fica vermelha e o indicador pulsa."/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== NOTAS ========== -->
                <StackPanel x:Name="PageNotes" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Notas e Todoist"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Escreva direto no widget de notas. Opcionalmente, espelhe uma lista do Todoist para editar pelo celular."/>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Conectar ao Todoist"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12">
                                Funciona no plano gratuito, nos dois sentidos. Copie seu token em
                                <Hyperlink NavigateUri="https://todoist.com/app/settings/integrations/developer"
                                           RequestNavigate="Link_RequestNavigate" Foreground="#A99FFF">Configurações → Integrações → Desenvolvedor</Hyperlink>
                                e cole abaixo. Ele fica criptografado com a sua conta do Windows.
                            </TextBlock>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Conectar" Margin="8,0,0,0" Click="TodoistConnect_Click"/>
                                <PasswordBox x:Name="TodoistTokenBox" Height="34"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}" Margin="0,14,0,0">
                                <ComboBox x:Name="TodoistProjectBox" DockPanel.Dock="Right" Width="280" DisplayMemberPath="Display"
                                          IsEnabled="False" SelectionChanged="TodoistProject_Changed"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Lista que aparece no widget" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="TodoistStatus" Style="{StaticResource Hint}"/>
                            <Button x:Name="TodoistDisconnect" Content="Desconectar" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Visibility="Collapsed" Click="TodoistDisconnect_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== IMAGEM ========== -->
                <StackPanel x:Name="PageImage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Imagem"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Uma foto, um mascote ou uma arte sua. GIFs mostram só o primeiro quadro."/>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Primary}" Content="Escolher imagem…" Click="PickImage_Click"/>
                                <Button Content="Remover" Margin="8,0,0,0" Click="RemoveImage_Click"/>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,14,0,8"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="PixelArtCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="PixelArt_Click"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Pixel art"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Amplia sem borrar, ideal para sprites pequenos."/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== BATERIA ========== -->
                <StackPanel x:Name="PageDevices" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Bateria dos dispositivos"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Fones, mouses, teclados e controles. Desligue o que não quiser ver no widget; a leitura é refeita a cada 3 minutos."/>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <StackPanel x:Name="DevicesPanel"/>
                            <Border Style="{StaticResource Divider}" Margin="0,10,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Primary}" Content="Procurar dispositivos agora" Click="RefreshDevices_Click"/>
                                <Button Content="Copiar diagnóstico" Margin="8,0,0,0" Click="CopyDiagnostics_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="DiagStatus" Style="{StaticResource Hint}"
                                       Text="Se um mouse ou fone não aparecer, copie o diagnóstico e envie numa issue para adicionar o suporte."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== GERAL ========== -->
                <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Geral"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Inicialização, atalhos e manutenção."/>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="StartupCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Startup_Click"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Iniciar com o Windows" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="StartMenuCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="StartMenu_Click"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Mostrar no menu Iniciar"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Deixe o DeskWidgets.exe numa pasta fixa; se mudar de lugar, abra uma vez pela nova pasta que o atalho se atualiza."/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Manutenção"/>
                            <WrapPanel>
                                <Button Content="Restaurar aparência padrão" Margin="0,0,8,8" Click="Reset_Click"/>
                                <Button Content="Abrir pasta de dados" Margin="0,0,8,8" Click="OpenData_Click"/>
                                <Button Content="Sair do DeskWidgets" Margin="0,0,8,8" Click="Exit_Click"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Configurações e notas ficam em %AppData%\DeskWidgets."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
