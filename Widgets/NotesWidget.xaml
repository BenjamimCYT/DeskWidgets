<local:WidgetBase x:Class="DeskWidgets.Widgets.NotesWidget"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:DeskWidgets.Widgets">
    <DockPanel Margin="14,10,10,12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11"
                    Style="{StaticResource GhostButton}" Padding="6,5" Click="ClearDone_Click" ToolTip="Limpar concluídos"/>
            <TextBlock x:Name="NotesCount" DockPanel.Dock="Right" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock x:Name="SyncIcon" DockPanel.Dock="Right" Text="&#xE753;" Style="{StaticResource IconText}"
                       FontSize="11" Opacity="0.65" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="Sincronizado com o Todoist"/>
            <TextBlock x:Name="NotesTitle" Text="Notas" Style="{StaticResource WidgetTitle}" FontSize="14" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" CornerRadius="9" Background="{DynamicResource SubtleBrush}" Margin="0,6,4,0" Padding="9,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE710;" Style="{StaticResource IconText}" FontSize="11"
                           Margin="0,0,8,0" Opacity="0.75"/>
                <Grid>
                    <TextBlock x:Name="NewPlaceholder" Text="Novo item…" FontSize="12.5" Opacity="0.55"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="NewBox" Style="{StaticResource BareTextBox}" FontSize="12.5"
                             KeyDown="NewBox_KeyDown" TextChanged="NewBox_TextChanged"/>
                </Grid>
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="NotesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel x:Name="Row" Margin="0,2" Background="Transparent">
                                <Button x:Name="Del" DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="8.5"
                                        Style="{StaticResource GhostButton}" Opacity="0" Click="Delete_Click" ToolTip="Excluir"/>
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Done}" Style="{StaticResource RoundCheck}"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="Txt" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BareTextBox}" FontSize="12.5"/>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Done}" Value="True">
                                    <Setter TargetName="Txt" Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter TargetName="Txt" Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Del" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="NotesEmpty" Text="Sua checklist está vazia. Escreva abaixo e tecle Enter." FontSize="11.5" Opacity="0.65"
                       TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center" Margin="6,0" IsHitTestVisible="False"/>
        </Grid>
    </DockPanel>
</local:WidgetBase>
