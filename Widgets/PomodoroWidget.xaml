<local:WidgetBase x:Class="DeskWidgets.Widgets.PomodoroWidget"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:DeskWidgets.Widgets"
                  xmlns:c="clr-namespace:DeskWidgets.Controls">
    <DockPanel Margin="12,10,12,12">
        <!-- Modos -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center">
            <RadioButton x:Name="ModeFocus" Content="Foco" Style="{StaticResource ChipRadio}" GroupName="pomo" Click="Mode_Click" Tag="0"/>
            <RadioButton x:Name="ModeShort" Content="Pausa" Style="{StaticResource ChipRadio}" GroupName="pomo" Click="Mode_Click" Tag="1"/>
            <RadioButton x:Name="ModeLong" Content="Longa" Style="{StaticResource ChipRadio}" GroupName="pomo" Click="Mode_Click" Tag="2"/>
        </StackPanel>

        <!-- Botões -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button Content="&#xE72C;" Style="{StaticResource RoundButton}" Background="{DynamicResource SubtleBrush}" Click="Reset_Click" ToolTip="Reiniciar"/>
            <Button x:Name="PlayButton" Content="&#xE768;" Style="{StaticResource FilledRoundButton}" Margin="10,0" Click="Play_Click" ToolTip="Iniciar / pausar"/>
            <Button Content="&#xE893;" Style="{StaticResource RoundButton}" Background="{DynamicResource SubtleBrush}" Click="Skip_Click" ToolTip="Pular para a próxima etapa"/>
        </StackPanel>

        <!-- Anel -->
        <Viewbox Stretch="Uniform" Margin="0,8,0,0">
            <Grid Width="130" Height="130">
                <Ellipse x:Name="Track" StrokeThickness="7" Stroke="{DynamicResource SubtleBrush}" Margin="0"/>
                <Path x:Name="Arc" StrokeThickness="7" Stroke="{DynamicResource AccentBrush}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TimeText" Text="25:00" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                        <c:AnimatedIcon x:Name="Glass" Kind="Hourglass" Width="11" Height="11" Margin="0,0,4,0" Opacity="0.85"/>
                        <TextBlock x:Name="ModeText" Text="Foco" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="CycleDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Viewbox>
    </DockPanel>
</local:WidgetBase>
