<local:WidgetBase x:Class="DeskWidgets.Widgets.BatteryWidget"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:DeskWidgets.Widgets"
                  xmlns:c="clr-namespace:DeskWidgets.Controls">
    <Grid Margin="6">
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <UniformGrid x:Name="DeviceGrid" Columns="2"/>
        </Viewbox>
        <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <c:AnimatedIcon x:Name="Scan" Kind="Wifi" Width="24" Height="24" Opacity="0.8"/>
            <TextBlock x:Name="EmptyText" Text="Nenhum dispositivo" FontSize="11" Opacity="0.7" Margin="0,6,0,0"
                       TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</local:WidgetBase>
