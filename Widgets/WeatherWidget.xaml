<local:WidgetBase x:Class="DeskWidgets.Widgets.WeatherWidget"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:DeskWidgets.Widgets"
                  xmlns:c="clr-namespace:DeskWidgets.Controls"
                  Cursor="Hand" MouseLeftButtonUp="Weather_Click">
    <Grid>
        <Image x:Name="WeatherIcon" Stretch="Uniform" HorizontalAlignment="Left" Margin="2,2,0,2"/>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.45" Color="Black"/>
            </StackPanel.Effect>
            <TextBlock x:Name="WeatherTemp" FontSize="32" FontWeight="Bold" HorizontalAlignment="Right" Text="--"/>
            <TextBlock x:Name="WeatherDesc" FontSize="10.5" HorizontalAlignment="Right" Opacity="0.85"
                       TextTrimming="CharacterEllipsis" MaxWidth="110"/>
            <TextBlock x:Name="WeatherCity" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis" MaxWidth="120" Margin="0,2,0,0"/>
        </StackPanel>
        <c:AnimatedIcon x:Name="Busy" Kind="Spinner" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,8,0" Visibility="Collapsed"/>
    </Grid>
</local:WidgetBase>
