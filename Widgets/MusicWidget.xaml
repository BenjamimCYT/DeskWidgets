<local:WidgetBase x:Class="DeskWidgets.Widgets.MusicWidget"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:DeskWidgets.Widgets"
                  xmlns:c="clr-namespace:DeskWidgets.Controls">
    <Grid>
        <!-- Capa desfocada de fundo (opcional) -->
        <Image x:Name="ArtBackdrop" Stretch="UniformToFill" Opacity="0.4" Visibility="Collapsed" Margin="-20">
            <Image.Effect>
                <BlurEffect Radius="28" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Capa do álbum -->
            <Border x:Name="ArtBox" Width="86" Height="86" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center"
                    Background="{DynamicResource SubtleBrush}">
                <Grid>
                    <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;" Style="{StaticResource IconText}" FontSize="28"
                               HorizontalAlignment="Center" Opacity="0.6"/>
                    <Border x:Name="ArtImage" CornerRadius="10"/>
                </Grid>
            </Border>

            <DockPanel Grid.Column="1">
                <!-- Título -->
                <DockPanel DockPanel.Dock="Top">
                    <c:AnimatedIcon x:Name="Eq" DockPanel.Dock="Right" Kind="Equalizer" Width="14" Height="14"
                                    Margin="6,1,0,0" VerticalAlignment="Top" Brush="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Nada tocando"/>
                </DockPanel>
                <TextBlock x:Name="ArtistText" DockPanel.Dock="Top" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Text="Abra o Spotify, o YouTube…"/>

                <!-- Controles -->
                <Grid DockPanel.Dock="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Elapsed" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PrevButton" Content="&#xE892;" Style="{StaticResource RoundButton}" Click="Prev_Click" ToolTip="Voltar"/>
                        <Button x:Name="PlayButton" Content="&#xE768;" Style="{StaticResource FilledRoundButton}" Margin="6,0"
                                Width="34" Height="34" Click="Play_Click" ToolTip="Tocar / pausar"/>
                        <Button x:Name="NextButton" Content="&#xE893;" Style="{StaticResource RoundButton}" Click="Next_Click" ToolTip="Próxima"/>
                    </StackPanel>
                    <TextBlock x:Name="Total" Grid.Column="2" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Progresso -->
                <Grid x:Name="ProgressRow" DockPanel.Dock="Bottom" Height="4" Margin="0,0,0,4" VerticalAlignment="Bottom">
                    <Border CornerRadius="2" Background="{DynamicResource SubtleBrush}"/>
                    <Border x:Name="ProgressFill" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Left" Width="0"/>
                </Grid>
                <Grid/>
            </DockPanel>
        </Grid>
    </Grid>
</local:WidgetBase>
